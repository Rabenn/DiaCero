<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado Pulsado: El botón baja y desaparece la sombra -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#E8DDFF" />
                    <stroke android:width="2dp" android:color="#D4C4FB" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Estado Normal: Con sombra inferior de 4dp -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#D4C4FB" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#E8DDFF" />
                    <stroke android:width="2dp" android:color="#D4C4FB" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>