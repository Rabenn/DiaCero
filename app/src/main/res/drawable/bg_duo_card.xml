<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- El "borde" o profundidad inferior -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <!-- Usa el color de variante de superficie del tema (gris oscuro en noche) -->
            <solid android:color="?attr/colorSurfaceVariant" />
        </shape>
    </item>

    <!-- El fondo principal -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <!-- Usa colorSurface para que sea blanco en día y gris casi negro en noche -->
            <solid android:color="?attr/colorSurface" />
            <stroke android:width="2dp" android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>