<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Borde inferior (Sombra sólida) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <!-- Usamos un color que en dark mode sea más oscuro -->
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
    <!-- Fondo principal -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <!-- IMPORTANTE: Usar colorSurface para que cambie a oscuro en Dark Mode -->
            <solid android:color="?attr/colorSurface" />
            <stroke android:width="2dp" android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>