<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. TEMA PRINCIPAL (Sin el "Base." para que el Manifest lo encuentre) -->
    <style name="Theme.DiaCero" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores principales para Modo Oscuro -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Fondo y Superficies en Oscuro -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>

        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>

        <!-- APLICACIÓN DE LA FUENTE BRAND_FONT -->
        <item name="android:fontFamily">@font/brand_font</item>
        <item name="fontFamily">@font/brand_font</item>
    </style>

    <!-- 2. TEMAS DE COLORES (Para evitar el error en BaseActivity.kt) -->
    <!-- Heredan todo lo anterior pero permiten que el sistema de ajustes funcione -->
    <style name="Theme.DiaCero.Blue" parent="Theme.DiaCero" />
    <style name="Theme.DiaCero.Green" parent="Theme.DiaCero" />
    <style name="Theme.DiaCero.Red" parent="Theme.DiaCero" />
    <style name="Theme.DiaCero.Purple" parent="Theme.DiaCero" />
    <style name="Theme.DiaCero.Yellow" parent="Theme.DiaCero" />
    <style name="Theme.DiaCero.Orange" parent="Theme.DiaCero" />
    <style name="Theme.DiaCero.DarkGreen" parent="Theme.DiaCero" />
    <style name="Theme.DiaCero.IntenseBlue" parent="Theme.DiaCero" />

    <!-- 3. ESTILO DUOLINGO PARA EL CALENDARIO (Modo Noche) -->
    <style name="DuoCalendarNumbers" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/brand_font</item>
    </style>

</resources>