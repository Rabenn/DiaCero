<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    tools:context=".ui.calendario.CalendarioFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp">

        <!-- 1. Buscador estilo Duolingo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_duo_card"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchViewEventos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@android:color/transparent"
                    app:queryHint="@string/buscar_eventos" />

                <Spinner
                    android:id="@+id/spinnerTipoFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:dropDownWidth="wrap_content"
                    android:overlapAnchor="false"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Card del Calendario con bordes sólidos de 2px -->
        <LinearLayout
            android:id="@+id/cardCalendarioContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_duo_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTituloCalendario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/brand_font"
                android:text="@string/calendario"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFechaSeleccionada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/brand_font"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:alpha="0.7"
                tools:text="Viernes, 27 de marzo de 2026" />

            <com.prolificinteractive.materialcalendarview.MaterialCalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:mcv_showOtherDates="all"
                app:mcv_selectionColor="@color/brand_purple" />
        </LinearLayout>

        <!-- 3. Título de Eventos (Sección plana) -->
        <TextView
            android:id="@+id/tvEventosDelDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/brand_font"
            android:paddingHorizontal="4dp"
            android:text="@string/eventos_del_dia"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 4. Lista de eventos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEventos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="92dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_evento" />

    </LinearLayout>

    <!-- Botones Flotantes estilo Duolingo (Elevation reducida para parecer planos) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabIrCasa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/ir_a_inicio"
        android:src="@drawable/ic_home"
        app:backgroundTint="@color/brand_blue"
        app:elevation="2dp"
        app:fabSize="mini"
        app:tint="@android:color/white" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarEvento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/a_adir_evento"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/brand_purple"
        app:elevation="4dp"
        app:tint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>