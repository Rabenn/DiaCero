<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="22dp"
    android:paddingTop="32dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Bienvenido a Dia Cero"
        android:textColor="?attr/colorOnSurface"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvBienvenida"
        app:layout_constraintBottom_toTopOf="@id/fabSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalendario"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="26dp"
            android:text="CALENDARIO"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:backgroundTint="@color/primary"
            app:cornerRadius="24dp"
            app:rippleColor="@color/secondary"
            app:strokeColor="@color/secondary"
            app:strokeWidth="3dp"
            app:elevation="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHabitos"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="16dp"
            android:text="HABITOS"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="24dp"
            app:rippleColor="@color/primary"
            app:strokeColor="@color/primary"
            app:strokeWidth="3dp"
            app:elevation="10dp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:contentDescription="Ajustes generales"
        android:src="@android:drawable/ic_menu_manage"
        app:backgroundTint="?attr/colorSurfaceVariant"
        app:elevation="6dp"
        app:maxImageSize="28dp"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
