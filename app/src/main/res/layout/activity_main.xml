<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Contenedor central para los botones principales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dia Cero"
                android:text="@string/dia_cero"
                android:textColor="?attr/colorPrimary"
                android:textSize="42sp"
                android:textStyle="bold"
                android:layout_marginBottom="56dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalendario"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Ver Calendario"
                android:text="@string/ver_calendario"
                android:textSize="18sp"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_my_calendar"
                app:iconSize="24dp"
                app:iconPadding="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHabitos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:text="Mis Hábitos"
                android:text="@string/mis_h_bitos"
                android:textSize="18sp"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconSize="24dp"
                app:iconPadding="12dp" />
        </LinearLayout>

        <!-- Botón de ajustes en la parte inferior del menú -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAjustes"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Ajustes"
            android:text="@string/ajustes"
            app:icon="@android:drawable/ic_menu_preferences" />

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Cambiar tema"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:fabSize="mini"
        app:elevation="4dp"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
